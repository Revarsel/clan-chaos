{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@clan-chaos/shared": [
        "./packages/shared/src/index.ts"
      ],
      "@clan-chaos/game-content": [
        "./packages/game-content/src/index.ts"
      ],
      "@clan-chaos/game-engine": [
        "./packages/game-engine/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/*/src",
    "apps/server/src",
    "tests",
    "prisma/seed.mts",
    "vitest.config.ts"
  ]
}