{
  "name": "clan-chaos",
  "private": true,
  "version": "1.2.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "concurrently -n server,web -c magenta,cyan \"pnpm --filter @clan-chaos/server dev\" \"pnpm --filter @clan-chaos/web dev\"",
    "dev:server": "pnpm --filter @clan-chaos/server dev",
    "dev:web": "pnpm --filter @clan-chaos/web dev",
    "build": "pnpm --filter @clan-chaos/web build",
    "start": "concurrently -n server,web \"pnpm --filter @clan-chaos/server start\" \"pnpm --filter @clan-chaos/web start\"",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:simulation": "vitest run tests/simulation",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @clan-chaos/web typecheck",
    "lint": "eslint .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --env-file=.env prisma/seed.mts",
    "docs:cards": "tsx scripts/generate-card-reference.mts",
    "postinstall": "prisma generate"
  },
  "prisma": { "schema": "prisma/schema.prisma", "seed": "tsx prisma/seed.mts" },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "prisma": "5.22.0",
    "socket.io-client": "4.8.1",
    "tsx": "^4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.18.0",
    "vitest": "2.1.9"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  }
}
