generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A guest identity bound to one room. Only a SHA-256 hash of the reconnect token is stored.
model GuestSession {
  id          String   @id
  name        String
  roomCode    String
  tokenHash   String   @unique
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  lastSeenAt  DateTime @default(now())

  participants MatchParticipant[]

  @@index([roomCode])
}

model Match {
  id          String    @id
  roomCode    String
  status      String // "in_progress" | "finished" | "abandoned"
  seed        String
  config      Json
  playerCount Int
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  endedReason String?

  participants MatchParticipant[]
  results      MatchResult[]
  events       MatchEvent[]
  snapshots    MatchSnapshot[]

  @@index([roomCode])
}

model MatchParticipant {
  id        String        @id @default(cuid())
  matchId   String
  playerId  String
  sessionId String?
  name      String
  clan      String
  seat      Int
  match     Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  session   GuestSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([matchId, playerId])
}

model MatchResult {
  id              String  @id @default(cuid())
  matchId         String
  playerId        String
  name            String
  clan            String
  rank            Int
  score           Int
  isWinner        Boolean
  eliminated      Boolean
  successfulRaids Int
  totalResources  Int
  fortDefense     Int
  breakdown       Json
  match           Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
}

/// Public match history (phase changes, raid outcomes, events) for debugging and replays.
model MatchEvent {
  id        BigInt   @id @default(autoincrement())
  matchId   String
  round     Int
  kind      String
  payload   Json
  createdAt DateTime @default(now())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
}

/// Debug snapshots of authoritative state at the end of each round (not used for crash recovery).
model MatchSnapshot {
  id        BigInt   @id @default(autoincrement())
  matchId   String
  round     Int
  phase     String
  state     Json
  createdAt DateTime @default(now())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
}
