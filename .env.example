# PostgreSQL connection used by Prisma and the game server
DATABASE_URL="postgresql://clanchaos:clanchaos@localhost:5432/clanchaos?schema=public"
# Game server
SERVER_HOST=0.0.0.0
SERVER_PORT=4000
# Comma separated list of allowed browser origins. "*" allows any origin on your LAN (dev only).
CORS_ORIGINS=*
# Set to "off" to run without PostgreSQL (results will NOT be stored). Default: on.
PERSISTENCE=on
# Optional phase durations in seconds (balance tuning)
BUILD_SECONDS=30
SCHEME_SECONDS=30
RESOLUTION_SECONDS=15
# NOTE: the web app does NOT read this file. To override where the browser connects (default: the
# page's own hostname on port 4000), put NEXT_PUBLIC_SERVER_URL=http://host:port in apps/web/.env.local
